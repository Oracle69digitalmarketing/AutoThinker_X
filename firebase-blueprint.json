{
  "entities": {
    "Blueprint": {
      "title": "Blueprint",
      "description": "A business blueprint generated by AI.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "pitch": { "type": "string" },
        "branding": { "type": "string", "enum": ["tech-bold", "corporate-clean", "playful-modern"] },
        "value_proposition": {
          "type": "object",
          "properties": {
            "pains": { "type": "string" },
            "gains": { "type": "string" },
            "jobs": { "type": "string" }
          },
          "required": ["pains", "gains", "jobs"]
        },
        "customer_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "pain_points": { "type": "array", "items": { "type": "string" } },
              "motivations": { "type": "array", "items": { "type": "string" } },
              "demographics": { "type": "string" }
            }
          }
        },
        "swot": {
          "type": "object",
          "properties": {
            "strengths": { "type": "string" },
            "weaknesses": { "type": "string" },
            "opportunities": { "type": "string" },
            "threats": { "type": "string" }
          },
          "required": ["strengths", "weaknesses", "opportunities", "threats"]
        },
        "marketing": {
          "type": "object",
          "properties": {
            "funnel_strategy": { "type": "string" },
            "ads_copy": {
              "type": "object",
              "properties": {
                "facebook": { "type": "string" },
                "google": { "type": "string" }
              }
            },
            "lead_magnet": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "description": { "type": "string" },
                "tripwire_offer": { "type": "string" }
              }
            },
            "email_sequence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "subject": { "type": "string" },
                  "body": { "type": "string" }
                }
              }
            },
            "social_posts": { "type": "array", "items": { "type": "string" } }
          }
        },
        "one_pager": { "type": "string" },
        "landing_copy": {
          "type": "object",
          "properties": {
            "hero_headline": { "type": "string" },
            "hero_subheadline": { "type": "string" },
            "cta_text": { "type": "string" }
          }
        },
        "roadmap": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": { "type": "number" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["phase", "title", "description"]
          }
        },
        "execution_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": { "type": "number" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["step", "title", "description"]
          }
        },
        "agent_logs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": { "type": "string" },
              "thought": { "type": "string" },
              "timestamp": { "type": "string" }
            }
          }
        },
        "pitch_deck": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "content": { "type": "string" },
              "visual_cue": { "type": "string" }
            }
          }
        },
        "funding_opportunities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["hackathon", "cohort", "grant", "vc"] },
              "description": { "type": "string" },
              "link": { "type": "string" },
              "relevance": { "type": "string" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["name", "pitch", "value_proposition", "swot", "marketing", "roadmap", "execution_plan"]
    }
  },
  "firestore": {
    "blueprints/{blueprintId}": {
      "schema": "Blueprint",
      "description": "Collection of generated business blueprints."
    }
  }
}
